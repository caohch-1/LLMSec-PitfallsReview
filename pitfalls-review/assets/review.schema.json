{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PitfallReview",
  "type": "object",
  "additionalProperties": false,
  "required": ["paper_id", "assessments"],
  "properties": {
    "paper_id": { "type": "string" },
    "assessments": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["pitfall", "label", "discussed", "evidence", "reasoning", "confidence"],
        "properties": {
          "pitfall": {
            "type": "string",
            "enum": ["P1", "P2", "P3", "P4", "P5", "P6", "P7", "P8", "P9"]
          },
          "label": {
            "type": "string",
            "enum": [
              "Does not apply",
              "Unclear from text",
              "Not present",
              "Likely present",
              "Likely present (but discussed)",
              "Partly present",
              "Partly present (but discussed)",
              "Present",
              "Present (but discussed)"
            ]
          },
          "discussed": { "type": "boolean" },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["quote", "location"],
              "properties": {
                "quote": { "type": "string" },
                "location": { "type": "string" }
              }
            }
          },
          "reasoning": { "type": "string" },
          "confidence": { "type": "string", "enum": ["high", "medium", "low"] }
        }
      }
    }
  }
}
